{
  "name": "nondominium-design-system",
  "version": "0.1.0",
  "description": "Design system, component registry and UI prototype for the Nondominium hApp",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "DEV=true vite dev",
    "build": "svelte-kit sync && bun run build:registry && vite build",
    "build:registry": "vite build --config vite.registry.config.ts",
    "build:all": "svelte-kit sync && bun run check && bun run build:registry && bun run build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run check:fidelity && bun run check:prototypes && bun run check:uno",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "check:fidelity": "bun run scripts/check-fidelity.ts",
    "check:fixture": "bun run scripts/check-fixture-keys.ts",
    "check:prototypes": "bun run scripts/check-prototype-rules.ts",
    "compare:prototypes": "bun run scripts/compare-prototypes.ts",
    "check:uno": "bun run scripts/check-uno-collisions.ts",
    "verify:prototypes": "bun run scripts/verify/run-all.ts"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/pngjs": "^6.0.5",
    "@unocss/extractor-svelte": "^66.6.8",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "melt": "^0.44.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "unocss": "^66.6.8",
    "vite": "^7.0.4"
  },
  "keywords": [
    "design-system",
    "holochain",
    "nondominium",
    "valueflows",
    "svelte"
  ]
}
