{
  "name": "nondominium-design-system",
  "version": "0.1.0",
  "description": "Design system and visual language for the Nondominium app",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:registry": "vite build --config vite.registry.config.ts",
    "build:all": "svelte-kit sync && bun run check && bun run build:registry && bun run build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@unocss/extractor-svelte": "^66.6.8",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "melt": "^0.44.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "unocss": "^66.6.8",
    "vite": "^7.0.4"
  }
}
